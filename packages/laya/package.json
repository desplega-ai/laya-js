{
  "name": "@desplega.ai/laya",
  "version": "0.1.0",
  "description": "Typesafe TypeScript runtime for laya decision models (Node, Bun).",
  "license": "Apache-2.0",
  "author": "Desplega Labs",
  "homepage": "https://github.com/desplega-ai/laya-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/desplega-ai/laya-js.git",
    "directory": "packages/laya"
  },
  "bugs": {
    "url": "https://github.com/desplega-ai/laya-js/issues"
  },
  "keywords": [
    "laya",
    "onnx",
    "onnxruntime",
    "decision-model",
    "classification",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/raw.d.ts",
      "import": "./dist/raw.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/copy-legal.mjs"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
