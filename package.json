{
  "name": "laya-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:bun-smoke": "bun run --filter @desplega/laya build && bun packages/laya/test/bun-smoke.ts",
    "check-vendor": "bun scripts/check-vendor.ts",
    "parity": "bun packages/laya/test/parity/run.ts"
  },
  "devDependencies": {
    "@desplega/laya": "workspace:*",
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
