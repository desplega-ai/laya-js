{
  "name": "laya-js",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:bun-smoke": "bun run --filter @desplega/laya build && bun packages/laya/test/bun-smoke.ts",
    "check-vendor": "bun scripts/check-vendor.ts",
    "parity": "bun packages/laya/test/parity/run.ts",
    "api:check": "bun run --filter @desplega/laya build && api-extractor run -c packages/laya/api-extractor.json",
    "api:update": "bun run --filter @desplega/laya build && api-extractor run --local -c packages/laya/api-extractor.json",
    "smoke:server": "bun run --filter @desplega/laya-server build && bun packages/laya-server/test/smoke.ts",
    "smoke:image": "bun scripts/smoke-image.ts",
    "eval:accuracy": "bun packages/laya/evals/accuracy.ts",
    "eval:gate": "bun packages/laya/evals/gate.ts",
    "eval:perf": "bun run --filter @desplega/laya build && bun packages/laya/evals/perf.ts",
    "eval:cost": "bun packages/laya/evals/cost.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@desplega/laya": "workspace:*",
    "@microsoft/api-extractor": "7.59.2",
    "@types/node": "22.20.4",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
